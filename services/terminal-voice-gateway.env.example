# Run this adapter on a Linux host. It does not contain the LLM key.
HOST=0.0.0.0
PORT=9896
ASR_URL=http://127.0.0.1:9880/asr
LLM_URL=http://127.0.0.1:9890/v1/chat/completions
LLM_MODEL=qwen3.8-27b-uncensored
LLM_API_KEY_FILE=/etc/c1max-terminal-voice/llm-api-key
MAX_AUDIO_BYTES=1200000
REQUEST_TIMEOUT=90
PREVIEW_TIMEOUT=6
# Optional. If set, the device must send Authorization: Bearer <AUTH_TOKEN>.
AUTH_TOKEN=
